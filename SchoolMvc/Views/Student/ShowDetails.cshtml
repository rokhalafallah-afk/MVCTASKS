@model StudentDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<h1>Student Details</h1>

<div class="card">
    <dl>
        <dt>Id</dt>
        <dd>@Model.Id</dd>
        <dt>Name</dt>
        <dd>@Model.Name</dd>
        <dt>Age</dt>
        <dd>@Model.Age</dd>
        <dt>Department</dt>
        <dd>@Model.DepartmentName</dd>
    </dl>
</div>

<h2>Courses &amp; Grades</h2>

@if (Model.Courses.Count == 0)
{
    <p>This student is not enrolled in any course yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Course</th>
                <th>Grade</th>
                <th>Min Degree</th>
                <th>Result</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Courses)
        {
            <tr>
                <td>@c.CourseName</td>
                <td>@c.Grade / @c.MaxDegree</td>
                <td>@c.MinDegree</td>
                <td class="@(c.Passed ? "pass" : "fail")">@(c.Passed ? "Passed" : "Failed")</td>
            </tr>
        }
        </tbody>
    </table>
}

<p style="margin-top:24px"><a class="btn" asp-action="ShowAll">&larr; Back to all students</a></p>
