@model IEnumerable<Student>
@{
    ViewData["Title"] = "All Students";
}

<h1>All Students</h1>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Department</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Id</td>
            <td>@s.Name</td>
            <td>@s.Age</td>
            <td>@s.Department.Name</td>
            <td><a class="btn" asp-action="ShowDetails" asp-route-id="@s.Id">Details</a></td>
        </tr>
    }
    </tbody>
</table>
